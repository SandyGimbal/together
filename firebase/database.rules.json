{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pairingCodes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "couples": {
      "$coupleId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
